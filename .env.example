VITE_API_KEY=your_api_key
VITE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_PROJECT_ID=your_project_id
VITE_STORAGE_BUCKET=your_project.appspot.com
VITE_MESSAGING_SENDER_ID=your_sender_id
VITE_APP_ID=your_app_id

# Update Center - GitHub integration (required for in-app deployment)
# Create a fine-grained PAT at: https://github.com/settings/tokens?type=beta
# Required permission: Contents (Read and Write) on your specific repo only
VITE_GITHUB_PAT=ghp_your_fine_grained_token_here
VITE_GITHUB_OWNER=your_github_username_or_org
VITE_GITHUB_REPO=GravityChat
VITE_GITHUB_BRANCH=main
