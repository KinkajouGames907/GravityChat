rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Fields that only the backend (Firebase Admin SDK / Vercel API routes) may write.
    // Clients calling setDoc/updateDoc cannot touch these — they will be rejected.
    function isSubscriptionField(field) {
      return field in ['tier', 'subscriptionId', 'subscriptionStatus', 'stripeCustomerId'];
    }

    // Returns true when the incoming write does NOT try to change any protected fields.
    function notModifyingSubscriptionFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['tier', 'subscriptionId', 'subscriptionStatus', 'stripeCustomerId']);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone logged in can read any user profile (needed for DMs, member lists, etc.)
      allow read: if request.auth != null;

      // A user can create their own document on first sign-in
      allow create: if request.auth != null && request.auth.uid == userId;

      // A user can update their OWN document, but CANNOT touch subscription fields
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && notModifyingSubscriptionFields();
    }

    // ── Usernames (uniqueness index) ─────────────────────────────────────────
    match /usernames/{username} {
      allow read: if request.auth != null;
      // Any authenticated user can claim/release their own username entry
      allow write: if request.auth != null;
    }

    // ── Servers ───────────────────────────────────────────────────────────────
    match /servers/{serverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Only the server owner or an admin member can update/delete
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // ── Channels ────────────────────────────────────────────────────────────
      match /channels/{channelId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // ── Members ─────────────────────────────────────────────────────────────
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // ── Messages ────────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Only the author or a server admin can edit/delete a message
        allow update, delete: if request.auth != null
                              && (resource.data.uid == request.auth.uid
                                  || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdminTeam == true);
      }
    }

    // ── DM Channels ───────────────────────────────────────────────────────────
    match /dms/{dmId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // ── Custom Emojis ─────────────────────────────────────────────────────────
    match /customEmojis/{emojiId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Only the uploader or super admin can delete
      allow delete: if request.auth != null
                    && (resource.data.uploaderId == request.auth.uid
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdminTeam == true);
    }

    // ── Friend requests / relationships ───────────────────────────────────────
    match /friends/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Update Center config (super admin only writes) ────────────────────────
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdminTeam == true;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
